rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function hasSafeInitialUserFields() {
      let data = request.resource.data;
      return (!('isAdmin' in data) || data.isAdmin == false) &&
             (!('isPro' in data) || data.isPro == false) &&
             (!('subscriptionStatus' in data) || data.subscriptionStatus == 'FREE');
    }

    function doesNotEscalateUserPrivileges() {
      let incoming = request.resource.data;
      let existing = resource.data;
      let adminUnchanged = incoming.get('isAdmin', false) == existing.get('isAdmin', false);
      let proUnchanged =
        incoming.get('isPro', false) == existing.get('isPro', false) &&
        incoming.get('subscriptionStatus', 'FREE') == existing.get('subscriptionStatus', 'FREE') &&
        incoming.get('planName', 'FREE') == existing.get('planName', 'FREE') &&
        incoming.get('planExpiryISO', null) == existing.get('planExpiryISO', null);

      let isSafeExpiryDowngrade =
        incoming.get('isPro', false) == false &&
        incoming.get('planName', 'FREE') == 'FREE' &&
        (incoming.get('subscriptionStatus', 'FREE') == 'EXPIRED' || incoming.get('subscriptionStatus', 'FREE') == 'FREE');

      return adminUnchanged && (proUnchanged || isSafeExpiryDowngrade);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && hasSafeInitialUserFields();
      allow update: if isAdmin() || (isOwner(uid) && doesNotEscalateUserPrivileges());
      allow delete: if isOwner(uid) || isAdmin();

      match /invoices/{invoiceId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /parties/{partyId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /inventory/{itemId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /audit_summaries/{summaryId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /audit_logs/{logId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    match /payment_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == "PENDING" &&
        request.resource.data.planAmount is number &&
        request.resource.data.planAmount >= 1 &&
        isValidString(request.resource.data.utrNumber, 6, 36);

      // Admin or the owner can update/manage their request status
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
