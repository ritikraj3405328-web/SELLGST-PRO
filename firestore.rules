rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // SERVER-SIDE MASTER ADMIN LOCK:
    // Only your verified Owner Gmail OR a user document explicitly marked isAdmin == true by you has Admin power
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ritikraj3405328@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )
      );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Blocks new users from creating an account with isAdmin: true or isPro: true
    function hasSafeInitialUserFields() {
      let data = request.resource.data;
      return (!('isAdmin' in data) || data.isAdmin == false) &&
             (!('isPro' in data) || data.isPro == false) &&
             (!('subscriptionStatus' in data) || data.subscriptionStatus == 'FREE');
    }

    // Blocks regular users/hackers from escalating their own profile to isPro: true or isAdmin: true from browser console
    function doesNotEscalateUserPrivileges() {
      let incoming = request.resource.data;
      let existing = resource.data;
      let adminUnchanged = incoming.get('isAdmin', false) == existing.get('isAdmin', false);
      let proUnchanged =
        incoming.get('isPro', false) == existing.get('isPro', false) &&
        incoming.get('subscriptionStatus', 'FREE') == existing.get('subscriptionStatus', 'FREE') &&
        incoming.get('planName', 'FREE') == existing.get('planName', 'FREE') &&
        incoming.get('planExpiryISO', null) == existing.get('planExpiryISO', null);

      let isSafeExpiryDowngrade =
        incoming.get('isPro', false) == false &&
        incoming.get('planName', 'FREE') == 'FREE' &&
        (incoming.get('subscriptionStatus', 'FREE') == 'EXPIRED' || incoming.get('subscriptionStatus', 'FREE') == 'FREE');

      return adminUnchanged && (proUnchanged || isSafeExpiryDowngrade);
    }

    // 1. STRICT UID ISOLATION FOR SELLER DATA (Invoices, Party Khata, Inventory)
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && hasSafeInitialUserFields();
      allow update: if isAdmin() || (isOwner(uid) && doesNotEscalateUserPrivileges());
      allow delete: if isOwner(uid) || isAdmin();

      match /invoices/{invoiceId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /parties/{partyId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /inventory/{itemId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /audit_summaries/{summaryId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /audit_logs/{logId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    // 2. PAYMENT REQUESTS (1 Request Per UID — Users can ONLY submit PENDING, ONLY Admin can APPROVE)
    match /payment_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == "PENDING" &&
        request.resource.data.planAmount is number &&
        request.resource.data.planAmount >= 1 &&
        isValidString(request.resource.data.utrNumber, 12, 12);

      // Users can update their own pending UTR, but CANNOT set status to "APPROVED"
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == "PENDING" &&
        isValidString(request.resource.data.utrNumber, 12, 12)
      );

      allow delete: if isAdmin();
    }

    // 3. SYSTEM CONFIG (UPI ID, Prices, Broadcast Banner — ONLY Admin can modify)
    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
