rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Prevent privilege escalation on new user profile creation
    function hasSafeInitialUserFields() {
      let data = request.resource.data;
      return (!('isAdmin' in data) || data.isAdmin == false) &&
             (!('isPro' in data) || data.isPro == false) &&
             (!('subscriptionStatus' in data) || data.subscriptionStatus == 'FREE');
    }

    // Prevent regular users from upgrading themselves to Pro or Admin,
    // while allowing automatic background expiry downgrade to FREE/EXPIRED.
    function doesNotEscalateUserPrivileges() {
      let incoming = request.resource.data;
      let existing = resource.data;

      let adminUnchanged = incoming.get('isAdmin', false) == existing.get('isAdmin', false);

      let proUnchanged =
        incoming.get('isPro', false) == existing.get('isPro', false) &&
        incoming.get('subscriptionStatus', 'FREE') == existing.get('subscriptionStatus', 'FREE') &&
        incoming.get('planName', 'FREE') == existing.get('planName', 'FREE') &&
        incoming.get('planExpiryISO', null) == existing.get('planExpiryISO', null);

      let isSafeExpiryDowngrade =
        incoming.get('isPro', false) == false &&
        incoming.get('planName', 'FREE') == 'FREE' &&
        (incoming.get('subscriptionStatus', 'FREE') == 'EXPIRED' || incoming.get('subscriptionStatus', 'FREE') == 'FREE');

      return adminUnchanged && (proUnchanged || isSafeExpiryDowngrade);
    }

    // =========================================================================
    // 1. USERS COLLECTION (/users/{uid})
    // =========================================================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // New user signup: strictly force Free & Non-Admin tier
      allow create: if isOwner(uid) && hasSafeInitialUserFields();

      // Profile updates: Users can update store info, GSTIN, freeActionsUsed,
      // and paymentPending flag, but NEVER upgrade isPro or isAdmin themselves.
      allow update: if isAdmin() || (isOwner(uid) && doesNotEscalateUserPrivileges());

      // DPDP Act 2023 Right to Erasure: Owner can delete their own account & data
      allow delete: if isOwner(uid) || isAdmin();

      // -----------------------------------------------------------------------
      // USER SUBCOLLECTIONS: Invoices, Parties (Udhar), Inventory Stock, Audits
      // -----------------------------------------------------------------------
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /parties/{partyId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /inventory/{itemId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // FIXED SYNTAX BUG: Removed space in `audit_summaries`
      match /audit_summaries/{summaryId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /audit_logs/{logId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // 2. SEMI-AUTOMATIC UPI PAYMENT REQUESTS (/payment_requests/{requestId})
    // =========================================================================
    match /payment_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == "PENDING" &&
        request.resource.data.planAmount is number &&
        request.resource.data.planAmount >= 1 &&
        isValidString(request.resource.data.utrNumber, 6, 36);

      // STRICT RULE: Only Admin can update status to "APPROVED" or "REJECTED"
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 3. SYSTEM SETTINGS & BROADCAST BANNERS (/system_config/{docId})
    // =========================================================================
    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 4. DEFAULT FALLBACK DENY
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
